	<!-- RoomService 등록 -->

	<!-- RoomService roomService = new RoomServiceImpl() -->
	<!-- <bean id="roomService" class="com.app.service.room.impl.RoomServiceImpl"> -->
	<!-- 1. 생성자를 통한 의존성 주입 -->
	<!-- RoomService roomService = new RoomServiceImpl(roomDAO) -->
	<!-- <constructor-arg ref="roomDAO"></constructor-arg> -->

	<!-- 2. setter 메소드를 통한 의존성 주입 -->
	<!-- RoomService roomService = new RoomServiceImpl(); roomService.setRoomDAO(roomDAO); -->
	<!-- <property name="roomDAO" ref="roomDAO"></property> -->
	<!-- </bean> -->

	<!-- 데이터베이스 연결 -->
	<bean class="org.apache.commons.dbcp2.BasicDataSource" id="data_source">
		<property name="driverClassName" value="oracle.jdbc.OracleDriver" />
		<property name="url" value="jdbc:oracle:thin:@192.168.0.8:1521:orcl" />
		<property name="username" value="scott" />
		<property name="password" value="tiger" />
	</bean>

	<!-- MyBatis 설정 -->
	<bean class="org.mybatis.spring.SqlSessionFactoryBean" id="sqlSessionFactory">
		<property name="dataSource" ref="data_source"></property>
		<property name="mapperLocations" value="/WEB-INF/mybatis/mapper/**/*_mapper.xml"></property>
		<property name="configLocation" value="/WEB-INF/mybatis/mybatis-config.xml"></property>		
		<property name="configurationProperties">
			<props>
				<prop key="mapUnderscoreToCamelCase">true</prop>
				<prop key="jdbcTypeForNull">NULL</prop>
			</props>
		</property>
	</bean>

	<bean id="sqlSessionTemplate" class="org.mybatis.spring.SqlSessionTemplate">
		<constructor-arg name="sqlSessionFactory" ref="sqlSessionFactory" />
	</bean>

	<bean class="org.mybatis.spring.mapper.MapperScannerConfigurer">
		<property name="basePackage" value="com.app.mapper" />
		<property name="annotationClass" value="org.apache.ibatis.annotations.Mapper" />
		<property name="sqlSessionFactoryBeanName" value="sqlSessionFactory" />
	</bean>
	
	<!-- JavaMailSender Bean Configuration -->
	<bean id="javaMailSender" class="org.springframework.mail.javamail.JavaMailSenderImpl">
		<property name="host" value="smtp.gmail.com" />
		<property name="port" value="587" />
		<property name="username" value="YOUR_EMAIL@gmail.com" />
		<property name="password" value="APP_PASSWORD" />
		<property name="javaMailProperties">
			<props>
				<prop key="mail.smtp.auth">true</prop>
				<prop key="mail.smtp.starttls.enable">true</prop>
			</props>
		</property>
	</bean>
	
	<!-- 서비스 패키지 스캔 설정 -->
	<context:component-scan base-package="com.app.service" />
</beans>